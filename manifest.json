{
    "manifest_version": 3,
    "name": "ServiceNow Status Generator",
    "version": "1.0",
    "description": "Creates summaries for ServiceNow incidents visible to the supporter.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://servicenow.idf.il/*",
        "http://localhost:11434/*"
    ],
    "action": {
        "default_title": "Generate Incident Summary"
    },
      "background": {
    "service_worker": "background.js"
  },
    "content_scripts": [
        {
            "matches": [
                "https://servicenow.idf.il/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "style.css"
            ],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ]
}